Repeater-Temperature OBJECT-TYPE
  SYNTAX  INTEGER
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          "Celsius degree"
  ::= {Repeater-Param 30}
----------------------------------------------------------------------
Repeater-Input-channel OBJECT-TYPE
  SYNTAX  INTEGER
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          "input channel number"
  ::= {Repeater-Param 40}  
----------------------------------------------------------------------
Repeater-Output-channel OBJECT-TYPE
  SYNTAX  INTEGER
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          "output channel number"
  ::= {Repeater-Param 41}  

----------------------------------------------------------------------
-----------------Repeater-Setting------------------------------------
----------------------------------------------------------------------

----------------------------------------------------------------------
Repeater-State OBJECT-TYPE
  SYNTAX  INTEGER{OFF(0),ON(1)}
  ACCESS  read-write
  STATUS  mandatory
  DESCRIPTION
          "OFF(0),ON(1)"
  ::= {Repeater-Setting 10}
----------------------------------------------------------------------
Repeater-Access-Boot OBJECT-TYPE
  SYNTAX  INTEGER{ACCESS_DENIED(0),ACCESS_ALLOWED(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "ACCESS_DENIED(0),ACCESS_ALLOWED(1))"
  ::= {Repeater-Setting 20}
----------------------------------------------------------------------
----------- Перезагрузка Repeater ------------------------------------
----------------------------------------------------------------------
Repeater-Reboot OBJECT-TYPE
  SYNTAX  INTEGER{Reboot(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "Reboot Repeater"
  ::= {Repeater-Setting 30}
----------------------------------------------------------------------
----------- Перезагрузка Repeater ------------------------------------
----------------------------------------------------------------------
Repeater-IncreasePowerBig OBJECT-TYPE
  SYNTAX  INTEGER{Step(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "Increase in output power, big step"
  ::= {Repeater-Setting 40}
----------------------------------------------------------------------
Repeater-IncreasePowerSmall OBJECT-TYPE
  SYNTAX  INTEGER{Step(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "Increase in output power, small step"
  ::= {Repeater-Setting 41}
----------------------------------------------------------------------
Repeater-DecreasePowerBig OBJECT-TYPE
  SYNTAX  INTEGER{Step(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "Decrease in output power, big step"
  ::= {Repeater-Setting 42}
----------------------------------------------------------------------
Repeater-DecreasePowerSmall OBJECT-TYPE
  SYNTAX  INTEGER{Step(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "Decrease in output power, small step"
  ::= {Repeater-Setting 43}      
----------------------------------------------------------------------
Repeater-DecreasePowerSave OBJECT-TYPE
  SYNTAX  INTEGER{Save(1)}
  ACCESS  write-only
  STATUS  mandatory
  DESCRIPTION
          "Save output power"
  ::= {Repeater-Setting 50}      

----------------------------------------------------------------------
-----------------------status Repeater--------------------------------
----------------------------------------------------------------------

Repeater-status-PowerOut OBJECT-TYPE
    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 1}
----------------------------------------------------------------------
Repeater-status-PowerRef OBJECT-TYPE
    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 2}
----------------------------------------------------------------------
