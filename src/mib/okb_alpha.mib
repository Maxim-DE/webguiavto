OKBALFA-MIB DEFINITIONS ::= BEGIN

IMPORTS
        enterprises
                FROM RFC1155-SMI
        OBJECT-TYPE,INTEGER
                FROM RFC-1212
        DisplayString
                FROM RFC-1213
        mib-2
                FROM RFC-2578;
