  SYNTAX  DisplayString
  ACCESS  read-only
  STATUS  mandatory
  DESCRIPTION
          "PCB revision"
  ::= {BlockControl1-Info 5}


----------------------------------------------------------------------
BlockControl1-Model OBJECT-TYPE
  SYNTAX  INTEGER{radio(0),digital(1)}
  ACCESS  read-only
  STATUS  mandatory
  DESCRIPTION
          "Model exciter radio or digital"
  ::= {BlockControl1-Info 5}
