    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 3}  
----------------------------------------------------------------------
Repeater-status-Pin OBJECT-TYPE
    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 4}  
----------------------------------------------------------------------
Repeater-status-U1 OBJECT-TYPE
    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 10}
----------------------------------------------------------------------
Repeater-status-I1 OBJECT-TYPE
    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 20}  
----------------------------------------------------------------------
Repeater-status-I2 OBJECT-TYPE
    SYNTAX  INTEGER{STATUS_LOW_FAIL(3),STATUS_OK(1),STATUS_ALARM(2),STATUS_FAIL(3),NOT_USED(255)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 21}
----------------------------------------------------------------------
Repeater-status-T OBJECT-TYPE
  SYNTAX  INTEGER{TempIsNotExist(0),TempIsNorm(1),TempIsOverheat(3)}
  ACCESS  read-only
  STATUS  current
  DESCRIPTION
          ""
  ::= {Repeater-Status 30}





